{
  "name": "@christianmoesl/radar-agent-host",
  "version": "0.1.0",
  "description": "Programmable pi-durable agents hosted by Radar",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": "./dist/src/index.js",
    "./tools": "./dist/src/tools.js",
    "./adapters": "./dist/src/adapters.js"
  },
  "bin": {
    "radar-agent-host": "./dist/src/runner.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "test": "node --experimental-strip-types --test --test-timeout=60000 test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm test",
    "build": "node build.mjs",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@earendil-works/chord": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-durable": "1.3.0",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChristianMoesl/radar.git",
    "directory": "agent-host"
  }
}
