{
  "datadog": {
    "site": "datadoghq.eu",
    "org": "radar",
    "config_dir": "/srv/radar-live/pup",
    "states_monitor_id": 123456,
    "no_data_monitor_id": 123457
  },
  "jira": {
    "profile": "radar",
    "site": "replace-with-jira-cloud-id",
    "config_dir": "/srv/radar-live/twg",
    "issue_keys": ["ABC-1", "ABC-2", "ABC-3"]
  },
  "mcp": {
    "config_file": "/srv/radar-live/mcp.json",
    "state_dir": "/srv/radar-live/mcp-state",
    "reads": [
      {"server": "jira", "tool": "searchJiraIssuesUsingJql", "arguments": {"cloudId": "replace-with-jira-cloud-id", "jql": "key in (ABC-1, ABC-2, ABC-3)", "maxResults": 1}},
      {"server": "jira", "tool": "getJiraIssue", "arguments": {"cloudId": "replace-with-jira-cloud-id", "issueIdOrKey": "ABC-1", "fields": ["comment"]}},
      {"server": "datadog", "tool": "search_datadog_monitors", "arguments": {"query": "tag:radar-oauth-e2e"}},
      {"server": "datadog", "tool": "get_datadog_metric", "arguments": {"query": "avg:datadog.apis.rate_limit.usage.per_org_pct{*}", "from": "now-15m", "to": "now"}}
    ]
  },
  "github": {
    "fixtures": [
      {"repository": "acme/oauth-e2e", "number": 1, "prefixes": ["ABC"], "state": "OPEN", "keys": ["mark:ABC-1"]},
      {"repository": "acme/oauth-e2e", "number": 2, "prefixes": ["ABC"], "state": "CLOSED", "keys": ["mark:ABC-1"]},
      {"repository": "acme/oauth-e2e", "number": 3, "prefixes": ["ABC"], "state": "MERGED", "keys": ["mark:ABC-1"]},
      {"repository": "acme/oauth-e2e", "number": 4, "prefixes": ["ABC"], "state": "OPEN", "keys": ["mark:ABC-2"]}
    ]
  }
}
